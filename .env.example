# DriveAnywhere.ai environment variables
# Copy this file to `.env.local` for local overrides.
# The app runs in mock mode when Supabase variables are missing.

# Public site URL (used for metadata and future share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional for Milestone 1 — leave blank to use mock mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser (Milestone 6+)
# SUPABASE_SERVICE_ROLE_KEY=
